### Richieste per POST /auth/register — IntelliJ HTTP Client (apri il file e premi ▶ accanto a ogni richiesta)
# Ogni richiesta ha un blocco `> {% %}` che controlla lo status atteso.
# {{$random.uuid}} genera un'email diversa a ogni esecuzione, così i 201 non diventano 409.

@host = http://localhost:8080

### 201 - utente valido senza sport
POST {{host}}/auth/register
Content-Type: application/json

{
  "firstName": "Lorenzo",
  "lastName": "Quaroni",
  "email": "lorenzo.{{$random.uuid}}@example.com",
  "password": "Str0ng!Passw0rd",
  "birthDate": "1999-04-23"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, "status " + response.status));
    client.test("Location punta a /users/userbyid", () =>
        client.assert(response.headers.valueOf("Location").includes("/users/userbyid?id=" + response.body.id),
            "Location: " + response.headers.valueOf("Location")));
    client.test("niente password nella risposta", () =>
        client.assert(response.body.password === undefined && response.body.hashPassword === undefined));
%}

### 201 - utente valido con sport
POST {{host}}/auth/register
Content-Type: application/json

{
  "firstName": "Mario",
  "lastName": "Rossi",
  "email": "mario.{{$random.uuid}}@example.com",
  "password": "Str0ng!Passw0rd",
  "birthDate": "1995-06-10",
  "sports": [
    { "sportType": "BJJ", "yearsPracticed": 4.5, "isCompeting": true },
    { "sportType": "Boxing", "yearsPracticed": 1.0, "isCompeting": false }
  ]
}

> {%
    client.test("201 con 2 sport", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.sports.length === 2, "sports: " + JSON.stringify(response.body.sports));
    });
%}

### 201 - lista sport vuota
POST {{host}}/auth/register
Content-Type: application/json

{
  "firstName": "Anna",
  "lastName": "Bianchi",
  "email": "anna.{{$random.uuid}}@example.com",
  "password": "Str0ng!Passw0rd",
  "birthDate": "2000-01-01",
  "sports": []
}

> {% client.test("201", () => client.assert(response.status === 201, "status " + response.status)); %}

### 201 - campo sconosciuto nel body: Jackson lo ignora
POST {{host}}/auth/register
Content-Type: application/json

{
  "firstName": "Luca",
  "lastName": "Verdi",
  "email": "luca.{{$random.uuid}}@example.com",
  "password": "Str0ng!Passw0rd",
  "birthDate": "1990-03-15",
  "role": "ADMIN"
}

> {% client.test("201, role ignorato", () => client.assert(response.status === 201, "status " + response.status)); %}

### --- Email duplicata: lancia le due richieste in ordine ---

### 201 - primo utente con email fissa (il 2° lancio di questa dà già 409)
POST {{host}}/auth/register
Content-Type: application/json

{
  "firstName": "Duplicato",
  "lastName": "Test",
  "email": "duplicato@example.com",
  "password": "Str0ng!Passw0rd",
  "birthDate": "1999-04-23"
}

### 409 - stessa email
POST {{host}}/auth/register
Content-Type: application/json

{
  "firstName": "Duplicato",
  "lastName": "DiNuovo",
  "email": "duplicato@example.com",
  "password": "Str0ng!Passw0rd",
  "birthDate": "1999-04-23"
}

> {% client.test("409 Conflict", () => client.assert(response.status === 409, "status " + response.status)); %}

### 409 atteso - stessa email in MAIUSCOLO
# Oggi risponde 201: findByEmail e il vincolo users_email_unique sono case-sensitive.
POST {{host}}/auth/register
Content-Type: application/json

{
  "firstName": "Duplicato",
  "lastName": "Maiuscolo",
  "email": "DUPLICATO@example.com",
  "password": "Str0ng!Passw0rd",
  "birthDate": "1999-04-23"
}

> {% client.test("409 (email case-insensitive)", () => client.assert(response.status === 409, "status " + response.status)); %}

